---
layout: null
---
[{% for post in site.posts %}{"id":{{ forloop.index }},"title":{{ post.title | jsonify }},"url":{{ post.url | relative_url | jsonify }},"date":{{ post.date | date: "%-d %b %Y" | jsonify }},"labels":{{ post.labels | join: ", " | jsonify }},"excerpt":{{ post.excerpt | strip_html | strip_newlines | truncate: 200 | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
